#!/bin/bash
# Mirrors what .github/workflows/ci.yml actually checks (build, vet,
# test, self-hosting round-trip), run once before code leaves the
# machine rather than relying on GitHub Actions catching it after the
# fact -- this repo's branch protection has enforce_admins=false, so a
# direct push to main by the repo owner bypasses the "test" required
# status check entirely.
set -e

echo "Running CI-equivalent checks before push..."

echo "-> build"
CGO_ENABLED=1 go build ./cmd/defn/

echo "-> vet"
go vet ./...

echo "-> staticcheck"
if command -v staticcheck &> /dev/null; then
  staticcheck ./...
else
  echo "staticcheck not installed -- skipping (install: go install honnef.co/go/tools/cmd/staticcheck@latest)"
fi

echo "-> unit tests"
# 10m, not 5m: internal/mcp's suite alone now runs ~5m46s after the
# wip-snapshot merge added its fuzz/differential tests (confirmed live
# 2026-08-20 -- 5m was cutting it close enough to fail outright under
# ordinary load variance, not hung, just genuinely slower). ci.yml
# needs the same bump or CI starts flaking at the same boundary.
CGO_ENABLED=1 go test ./... -count=1 -timeout 10m

echo "-> self-hosting round-trip"
# Isolated tempdir DB, not the repo's own .defn -- that one is
# routinely held open by a live `defn serve` during normal
# development (e.g. an active MCP session), and this check has no
# need to share it: a fresh ingest into scratch space is a truer
# match for what CI's fresh-checkout run does anyway.
#
# --reindex skips the onboarding-file writes (CLAUDE.md, .mcp.json,
# .gitignore, .codex config) that a plain `defn ingest` performs --
# without it, every push would leave the real working tree's CLAUDE.md
# etc. dirtied by this check's own side effect, confirmed live the
# first time this hook ran for real.
EMIT_DIR=$(mktemp -d)
ROUNDTRIP_DB=$(mktemp -d)
DEFN_DB="$ROUNDTRIP_DB" ./defn ingest . --reindex
DEFN_DB="$ROUNDTRIP_DB" ./defn emit "$EMIT_DIR"
(cd "$EMIT_DIR" && go build ./cmd/defn/)
rm -rf "$EMIT_DIR" "$ROUNDTRIP_DB"

echo "All CI-equivalent checks passed."
